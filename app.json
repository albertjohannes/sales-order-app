{
  "expo": {
    "name": "SalesOrderApp",
    "slug": "sales-order-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sales_logo.png",
    "scheme": "salesorderapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs location access to capture GPS coordinates for outlet location.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.albertandme.salesorderapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sales_logo.png",
        "backgroundColor": "#ffffff"
      },
      "icon": "./assets/images/sales_logo.png",
      "edgeToEdgeEnabled": true,
      "package": "com.albertandme.salesorderapp",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/sales_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sales_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22371f46-28c5-4ff2-a918-ea1552d4ed55"
      }
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/22371f46-28c5-4ff2-a918-ea1552d4ed55"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
